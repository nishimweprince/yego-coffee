# Yego Coffee — environment contract (plan.md §30)
# Copy to .env.local and fill in. Never commit .env.local.

# --- Core (required to boot) ---------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Shopify Storefront (required to query the catalogue) ----
# Must be the *.myshopify.com domain, not yegocoffee.com.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Private Storefront access token from a Shopify custom app.
# Scopes: unauthenticated_read_product_listings
#         unauthenticated_read_selling_plans  (needed from Phase 2)
# Never prefix this with NEXT_PUBLIC_ — that inlines it into the
# client bundle at build time and cannot be walked back.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
