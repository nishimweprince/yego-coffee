# Yego Coffee — environment contract (plan.md §30)
# Copy to .env.local and fill in. Never commit .env.local.

# --- Core (required to boot) ---------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Shopify Storefront (required to query the catalogue) ----
# Must be the *.myshopify.com domain, not yegocoffee.com.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Public Storefront API access token from a Shopify custom app
# (Admin → Apps → Develop apps → Configuration → Storefront API).
# Scopes: unauthenticated_read_product_listings
#         unauthenticated_read_selling_plans  (needed from Phase 2)
# This is the public token, not the Admin API (shpat_…) token and not
# the private (shpt_…) token — the app sends it on the
# X-Shopify-Storefront-Access-Token header, which only accepts public tokens.
# Never prefix this with NEXT_PUBLIC_ — that inlines it into the
# client bundle at build time and cannot be walked back.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Analytics (all optional) --------------------------------
# Absent keys disable the provider; the site boots and works
# normally without any of them (plan.md §31, §94.2's split).
# A key that is present but malformed is reported at startup.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Customer Account API (Phase 6) --------------------------
# From Shopify Admin → Settings → Customer accounts → Headless /
# Customer Account API. Callback URL must be registered there as
# <NEXT_PUBLIC_SITE_URL>/account/callback.
# Until these exist, Phase 6 cannot be built against anything real
# (plan.md §100.5).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_URL=

# --- Webhooks (plan.md §23) ----------------------------------
# Shared secret from the Shopify webhook subscription; used to
# verify the HMAC on every incoming webhook before acting on it.
SHOPIFY_WEBHOOK_SECRET=
